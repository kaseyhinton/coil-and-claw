{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coil-and-claw",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The worker sees every request so it can redirect www to the canonical domain.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "coilandclaw.us", "custom_domain": true },
    { "pattern": "www.coilandclaw.us", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coil-and-claw-db",
      "database_id": "43e357fc-2ed0-4860-8ea2-70a7277f2ce6",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "coil-and-claw-photos" }
  ],
  "send_email": [{ "name": "EMAIL", "remote": true }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "4201", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-flash-latest",
    "CANONICAL_HOST": "coilandclaw.us",
    "EMAIL_FROM": "noreply@southernutahsoftware.com"
  }
}
